# Variables de entorno — copiar a .env y completar
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga
SUPERADMIN_PASSWORD=admin1234
PORT=3001
# Clave secreta de Cloudflare Turnstile (captcha del login).
# Sin esta variable el login no verifica captcha (solo para desarrollo local).
TURNSTILE_SECRET=
# Si la API corre detrás de un proxy (Render, Railway, Nginx...), poner 1
# para que el límite de intentos use la IP real del visitante.
TRUST_PROXY=
